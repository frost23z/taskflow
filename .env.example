# Copy this file to .env and adjust. .env is gitignored; keep secrets out of this file.

# "dev" turns on SQL logging (SQLAlchemy echo). Any other value turns it off.
APP_ENV=dev

# App database (SQLite). Default if unset: <project root>/data/tasks.db
# Relative paths are resolved from the directory you start the app in.
DATABASE_URL=sqlite:///data/tasks.db

# Database used by pytest: a separate file that is wiped on every test.
# Default if unset: <project root>/data/test.db. Must differ from DATABASE_URL.
TEST_DATABASE_URL=sqlite:///data/test.db

# ChromaDB search index (persistent). Default if unset: <project root>/data/chroma
# It is only an index: delete it any time and `uv run python -m app.seed` or reindex_all rebuilds it.
CHROMA_PATH=data/chroma

# LLM fallback chain: ordered, comma-separated "provider:model" entries, best first. The first
# usable entry is the primary; the rest are tried in order when it hits a rate limit (429/quota),
# a timeout, a connection error or a 5xx. Entries are split on the FIRST colon only, so model
# names may contain colons (OpenRouter ":free"). The same provider may appear several times.
# Providers: google_genai, groq, openrouter. Entries whose key below is empty are skipped.
# Ordered fastest and most reliable first (measured with scripts/check_models.py). Free-tier limits
# are per model on Gemini and Groq, but one shared cap for every OpenRouter ":free" model.
# openrouter/free lets OpenRouter pick a free model that supports tool calling.
# removed google_genai:gemini-3.8-flash. takes too long to respond.
LLM_CHAIN=groq:openai/gpt-oss-120b,google_genai:gemini-3.5-flash-lite,google_genai:gemini-3.6-flash,google_genai:gemini-3.1-flash-lite,openrouter:openrouter/free

# API keys (https://aistudio.google.com/app/apikey, https://console.groq.com/keys,
# https://openrouter.ai/keys). Any key variable may hold several comma-separated keys: each entry
# is then tried with every key in order (logged as provider:model#1, #2, ...) before the chain moves
# to the next entry. Gemini limits are per Google Cloud project, not per key, so extra keys only
# help if each one comes from a different project: GOOGLE_API_KEY=key_project_a,key_project_b
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
