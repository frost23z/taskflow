# Copy this file to .env and adjust. .env is gitignored; keep secrets out of this file.

# "dev" turns on SQL logging (SQLAlchemy echo). Any other value turns it off.
APP_ENV=dev

# App database (SQLite). Default if unset: <project root>/data/tasks.db
# Relative paths are resolved from the directory you start the app in.
DATABASE_URL=sqlite:///data/tasks.db

# Database used by pytest: a separate file that is wiped on every test.
# Default if unset: <project root>/data/test.db. Must differ from DATABASE_URL.
TEST_DATABASE_URL=sqlite:///data/test.db

# ChromaDB search index (persistent). Default if unset: <project root>/data/chroma
# It is only an index: delete it any time and `uv run python -m app.seed` or reindex_all rebuilds it.
CHROMA_PATH=data/chroma
